{
  "name": "@q-tguudiilt/acp",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live:kiro": "vitest run --config vitest.integration.config.ts drivers/__integration__/kiro.integration.test.ts",
